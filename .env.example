# Dynaxis Labs Studios — environment template (do not commit secrets)

# Required for Phase 3 platform persistence (Projects, Assets, Generations, Jobs)
# PostgreSQL connection string — production authoritative store
DATABASE_URL=postgresql://dynaxis:dynaxis@localhost:5432/dynaxis

# Optional pool size for postgres.js
# DATABASE_POOL_MAX=10

# ── Dynaxis Authentication (Phase 7C.1) ──────────────────────────────────────
# Required in production. Generate a long random secret; never commit real values.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Test/local-only escape hatch for importing auth config without a real secret.
# Never set this in production.
# DYNAXIS_AUTH_ALLOW_INSECURE_TEST_SECRET=1

# Optional MuAPI host override for server-side adapter (default https://api.muapi.ai)
# MUAPI_API_HOST=https://api.muapi.ai

# Test-only memory store (never use in production)
# DYNAXIS_PLATFORM_DRIVER=memory
# DYNAXIS_ALLOW_MEMORY_STORE=1

# ── Asset Blob Store (Phase 6E.1) ─────────────────────────────────────────────
# Driver: memory (tests) | filesystem (local dev) | s3 (production)
# DYNAXIS_ASSET_STORAGE=filesystem
# DYNAXIS_ASSET_FS_ROOT=.dynaxis-blob-store

# Production S3-compatible object storage (required when DYNAXIS_ASSET_STORAGE=s3)
# DYNAXIS_S3_BUCKET=dynaxis-assets
# DYNAXIS_S3_REGION=us-east-1
# DYNAXIS_S3_ENDPOINT=                 # optional custom endpoint (MinIO, R2, …)
# DYNAXIS_S3_FORCE_PATH_STYLE=1        # often required for MinIO
# DYNAXIS_S3_ACCESS_KEY_ID=
# DYNAXIS_S3_SECRET_ACCESS_KEY=
# DYNAXIS_S3_PREFIX=dynaxis
# Optional public/CDN base URL for object URLs (otherwise dynaxis-blob:// + /api/dynaxis/assets/:id/content)
# DYNAXIS_ASSET_PUBLIC_BASE_URL=https://cdn.example.com/dynaxis
